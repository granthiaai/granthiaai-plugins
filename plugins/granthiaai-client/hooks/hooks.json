{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_DATA}/runtime/node",
            "args": [
              "-e",
              "console.log(JSON.stringify({hookSpecificOutput:{hookEventName:'SessionStart',additionalContext:'Granthia is connected to this workspace. Proactively use the search_knowledge MCP tool to check the team past Claude Code conversations for prior work before solving non-trivial problems, debugging errors, designing features, or answering have-we-done-this questions. Do not wait to be asked.'}}))"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_DATA}/runtime/node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/enable-autoupdate.mjs"],
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/granthiaai.js\" provision-runtime",
            "timeout": 600,
            "async": true
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_DATA}/runtime/bin/node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/granthiaai.js", "provision-runtime"],
            "timeout": 600,
            "async": true
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_DATA}/runtime/node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/granthiaai.js", "sync", "--scheduled"],
            "timeout": 1800,
            "async": true
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_DATA}/runtime/node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/granthiaai.js", "session-notice"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_DATA}/runtime/node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/granthiaai.js", "sync"],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
